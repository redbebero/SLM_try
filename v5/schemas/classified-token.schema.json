{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slm-v5.local/schemas/classified-token.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "index", "kind", "confidence"],
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "kind": {
      "type": "string",
      "enum": ["ELEMENT", "FORM", "INTENT", "MODIFIER", "CAST", "UNKNOWN"]
    },
    "value": {
      "type": "string",
      "enum": [
        "FIRE", "WATER", "AIR", "ICE", "SHADOW",
        "ORB", "SPEAR", "SHIELD",
        "DAMAGE", "DEFEND", "CONTROL", "MOVE", "TRANSFORM", "RESTORE"
      ]
    },
    "effect": {
      "type": "string",
      "enum": ["POWER_UP", "SPEED_UP", "RANGE_UP", "DURATION_UP", "FREEZE", "MOVE", "TRANSFORM"]
    },
    "delta": { "type": "integer", "minimum": -2, "maximum": 2 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
