{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slm-v5.local/schemas/training-token-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "input", "target", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incantation", "token", "index", "prefix", "spell_context"],
      "properties": {
        "incantation": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "prefix": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "spell_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "element", "form", "power", "speed"],
          "properties": {
            "phase": {
              "type": "string",
              "enum": ["ELEMENT", "FORM", "MODIFIER", "CAST", "READY_TO_CAST"]
            },
            "element": {
              "type": ["string", "null"],
              "enum": ["FIRE", "WATER", "AIR", "ICE", "SHADOW", null]
            },
            "form": {
              "type": ["string", "null"],
              "enum": ["ORB", "SPEAR", "SHIELD", null]
            },
            "power": { "type": "integer", "minimum": 0, "maximum": 5 },
            "speed": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ELEMENT", "FORM", "INTENT", "MODIFIER", "CAST", "UNKNOWN"]
        },
        "value": {
          "type": "string",
          "enum": [
            "FIRE", "WATER", "AIR", "ICE", "SHADOW",
            "ORB", "SPEAR", "SHIELD",
            "DAMAGE", "DEFEND", "CONTROL", "MOVE", "TRANSFORM", "RESTORE"
          ]
        },
        "effect": {
          "type": "string",
          "enum": ["POWER_UP", "SPEED_UP", "RANGE_UP", "DURATION_UP", "FREEZE", "MOVE", "TRANSFORM"]
        },
        "delta": { "type": "integer", "minimum": -2, "maximum": 2 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_id", "verified"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["HUMAN_AUTHORED", "PUBLIC_DOMAIN_ADAPTATION", "SYNTHETIC", "HARD_NEGATIVE"]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "PUBLIC_DOMAIN_ADAPTATION" } },
            "required": ["type"]
          },
          "then": {
            "required": ["source_url"],
            "properties": { "source_url": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
