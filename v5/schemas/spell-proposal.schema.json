{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://slm-v5.local/schemas/spell-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "element", "form", "target",
    "power", "speed", "range", "duration", "confidence"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["PROPOSAL", "UNKNOWN"] },
    "element": {
      "type": "string",
      "enum": ["FIRE", "WATER", "AIR", "EARTH", "ICE", "LIGHT", "SHADOW", "UNKNOWN"]
    },
    "form": {
      "type": "string",
      "enum": ["ORB", "SPEAR", "SHIELD", "BEAM", "UNKNOWN"]
    },
    "target": {
      "type": "string",
      "enum": ["SELF", "ENEMY", "AREA", "UNKNOWN"]
    },
    "power": { "type": "integer", "minimum": 0, "maximum": 5 },
    "speed": { "type": "integer", "minimum": 0, "maximum": 5 },
    "range": { "type": "integer", "minimum": 0, "maximum": 5 },
    "duration": { "type": "integer", "minimum": 0, "maximum": 5 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
